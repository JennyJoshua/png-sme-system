# Copy to .env.local and fill in values from your OWN Supabase project settings.
# Only browser-safe values belong here. NEVER add a service-role / secret key
# to this app (no variable name containing SERVICE_ROLE or SECRET).

# Project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=your-project-url-here

# Browser-safe "publishable" (or legacy "anon") key. Safe ONLY because RLS is enabled.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
